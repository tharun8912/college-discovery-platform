generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique
  password         String
  name             String?
  createdAt        DateTime           @default(now())
  savedColleges    SavedCollege[]
  savedComparisons SavedComparison[]
  questions        Question[]
  answers          Answer[]
}

model College {
  id                  Int            @id @default(autoincrement())
  name                String
  slug                String         @unique
  shortName           String?
  location            String
  state               String?
  nirfRank            Int?
  careers360Rating    Float?
  fees                Int
  avgPackage          Float?
  highestPackage      Float?
  placementPercentage Float?
  courses             String[]       @default([])
  examsAccepted       String[]       @default([])
  ownershipType       String?
  establishedYear     Int?
  accreditation       String?
  featured            Boolean        @default(false)
  description         String?
  detailedOverview    String?
  admissionProcess    String?
  eligibility         String?
  facilities          String[]       @default([])
  recruiters          String[]       @default([])
  rankings            Json?
  images              Json?
  logo                String?
  campusSize          String?
  facultyCount        Int?
  studentCount        Int?
  officialWebsite     String?
  
  // Legacy fields mapped/kept for compatibility if needed
  rating              Float?
  placement           Float?
  banner              String?
  image               String?
  campusImages        String[]       @default([])
  website             String?
  ranking             Int?
  acceptedExams       String[]       @default([])
  cutoffRank          Int?

  createdAt           DateTime       @default(now())
  reviews             Review[]
  savedBy             SavedCollege[]
}

model Review {
  id        Int      @id @default(autoincrement())
  collegeId Int
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  author    String
  rating    Float
  comment   String
  createdAt DateTime @default(now())
}

model Question {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String
  body      String
  author    String
  createdAt DateTime @default(now())
  answers   Answer[]
}

model Answer {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  body       String
  author     String
  createdAt  DateTime @default(now())
}

model SavedCollege {
  id        Int     @id @default(autoincrement())
  userId    Int
  collegeId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
}

model SavedComparison {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String?
  collegeIds Int[]
  createdAt  DateTime @default(now())
}
